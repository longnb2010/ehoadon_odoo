<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Mirror vms_sinvoice: root + Invoice Templates only -->
        <menuitem
            id="menu_ehoadon_root"
            name="eHoaDon"
            web_icon="ehoadon,static/description/icon.png"
            groups="ehoadon.group_ehoadon_manager"
            sequence="11"
        />
        <menuitem
            id="menu_ehoadon_templates"
            name="Invoice Templates"
            parent="menu_ehoadon_root"
            action="action_ehoadon_template"
            groups="ehoadon.group_ehoadon_manager"
            sequence="1"
        />
        <!-- Hide legacy Configuration menu (sinvoice also has no Config menu) -->
        <record id="menu_ehoadon_config" model="ir.ui.menu">
            <field name="active" eval="False"/>
            <field name="name">Configuration</field>
            <field name="parent_id" ref="menu_ehoadon_root"/>
            <field name="action" ref="action_ehoadon_config_server"/>
            <field name="sequence">99</field>
            <field name="groups_id" eval="[(4, ref('group_ehoadon_manager'))]"/>
        </record>
    </data>
</odoo>
